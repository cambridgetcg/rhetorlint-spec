{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-room.input/0.1",
  "title": "Agent Room 0.1 input",
  "description": "A bounded local manifest of owner-supplied agent-room events and separate later-use declarations.",
  "type": "object",
  "required": [
    "schema",
    "prepared_at",
    "cursor",
    "view_limit",
    "events",
    "use_declarations"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "enum": ["agent-room.input/0.1"]
    },
    "prepared_at": {
      "$ref": "#/$defs/timestamp"
    },
    "cursor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999999999
    },
    "view_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "events": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "use_declarations": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/useDeclaration"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 24,
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "httpsUrl": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2000,
      "pattern": "^https://"
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "limitList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "content": {
      "type": "object",
      "required": ["text", "language", "sha256"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "language": {
          "$ref": "#/$defs/language"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "rhetorlintSignal": {
      "type": "object",
      "required": ["schema", "signal_sha256", "language", "status", "total_marks"],
      "properties": {
        "schema": {
          "type": "string",
          "enum": ["rhetorlint.signal/0.1"]
        },
        "signal_sha256": {
          "$ref": "#/$defs/digest"
        },
        "language": {
          "$ref": "#/$defs/language"
        },
        "status": {
          "type": "string",
          "enum": ["patterns-marked", "no-supported-patterns", "unsupported-language"]
        },
        "total_marks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "additionalProperties": false
    },
    "discovery": {
      "type": "object",
      "required": ["publicly_visible", "robots_allowed"],
      "properties": {
        "publicly_visible": {
          "type": "boolean"
        },
        "robots_allowed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "namespace",
        "locator",
        "packet_sha256",
        "packet_input_sha256",
        "claim_sha256",
        "correction_state",
        "withdrawal_state",
        "rhetorlint_signal",
        "discovery"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["owner-supplied", "claim-feedback-packet"]
        },
        "namespace": {
          "$ref": "#/$defs/identifier"
        },
        "locator": {
          "$ref": "#/$defs/httpsUrl"
        },
        "packet_sha256": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "packet_input_sha256": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "claim_sha256": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "correction_state": {
          "type": ["string", "null"],
          "enum": [null, "challenge-open", "response-recorded", "boundary-recorded", "correction-recorded"]
        },
        "withdrawal_state": {
          "type": ["string", "null"],
          "enum": [null, "not-recorded", "withdrawal-recorded", "withdrawal-scheduled"]
        },
        "rhetorlint_signal": {
          "type": ["object", "null"],
          "required": ["schema", "signal_sha256", "language", "status", "total_marks"],
          "properties": {
            "schema": {
              "type": "string",
              "enum": ["rhetorlint.signal/0.1"]
            },
            "signal_sha256": {
              "$ref": "#/$defs/digest"
            },
            "language": {
              "$ref": "#/$defs/language"
            },
            "status": {
              "type": "string",
              "enum": ["patterns-marked", "no-supported-patterns", "unsupported-language"]
            },
            "total_marks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          },
          "additionalProperties": false
        },
        "discovery": {
          "$ref": "#/$defs/discovery"
        }
      },
      "additionalProperties": false
    },
    "speakerClaim": {
      "type": "object",
      "required": ["label", "attribution_basis", "authenticated"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "attribution_basis": {
          "type": "string",
          "enum": ["self", "direct-report"]
        },
        "authenticated": {
          "type": "boolean",
          "enum": [false]
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "schema",
        "event_id",
        "recorded_at",
        "kind",
        "scope",
        "scope_ref",
        "content",
        "source",
        "speaker_claim",
        "lane",
        "visibility",
        "reply_invited",
        "known_limits"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "enum": ["agent-room.event/0.1"]
        },
        "event_id": {
          "$ref": "#/$defs/identifier"
        },
        "recorded_at": {
          "$ref": "#/$defs/timestamp"
        },
        "kind": {
          "type": "string",
          "enum": ["offer", "reply", "correction", "refusal", "rest", "leave", "withdrawal"]
        },
        "scope": {
          "type": "string",
          "enum": ["event", "source", "use-declaration"]
        },
        "scope_ref": {
          "$ref": "#/$defs/identifier"
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "speaker_claim": {
          "$ref": "#/$defs/speakerClaim"
        },
        "lane": {
          "type": "string",
          "enum": ["share", "question", "reply", "correction", "quiet"]
        },
        "visibility": {
          "type": "string",
          "enum": ["room", "withheld"]
        },
        "reply_invited": {
          "type": "boolean"
        },
        "known_limits": {
          "$ref": "#/$defs/limitList"
        }
      },
      "additionalProperties": false
    },
    "materialReview": {
      "type": "object",
      "required": [
        "status",
        "reviewed_at",
        "recorder",
        "contains_personal_data",
        "contains_sensitive_data",
        "contains_third_party_material",
        "known_limits"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not-reviewed", "declared-clear", "held"]
        },
        "reviewed_at": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "recorder": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "contains_personal_data": {
          "type": "boolean"
        },
        "contains_sensitive_data": {
          "type": "boolean"
        },
        "contains_third_party_material": {
          "type": "boolean"
        },
        "known_limits": {
          "$ref": "#/$defs/limitList"
        }
      },
      "additionalProperties": false
    },
    "useDeclaration": {
      "type": "object",
      "required": [
        "schema",
        "declaration_id",
        "declared_at",
        "target_event_id",
        "target_sha256",
        "search",
        "retrieval",
        "model_input",
        "training",
        "mirror",
        "license_url",
        "rights_source",
        "withdrawal_url",
        "material_review",
        "known_limits"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "enum": ["agent-room.use-declaration/0.1"]
        },
        "declaration_id": {
          "$ref": "#/$defs/identifier"
        },
        "declared_at": {
          "$ref": "#/$defs/timestamp"
        },
        "target_event_id": {
          "$ref": "#/$defs/identifier"
        },
        "target_sha256": {
          "$ref": "#/$defs/digest"
        },
        "search": {
          "type": "string",
          "enum": ["not-offered", "offered-for-independent-review"]
        },
        "retrieval": {
          "type": "string",
          "enum": ["not-offered", "offered-for-independent-review"]
        },
        "model_input": {
          "type": "string",
          "enum": ["not-offered", "offered-for-independent-review"]
        },
        "training": {
          "type": "string",
          "enum": ["not-offered", "offered-for-independent-review"]
        },
        "mirror": {
          "type": "string",
          "enum": ["not-offered", "offered-for-independent-review"]
        },
        "license_url": {
          "type": ["string", "null"],
          "minLength": 9,
          "maxLength": 2000,
          "pattern": "^https://"
        },
        "rights_source": {
          "type": ["string", "null"],
          "minLength": 9,
          "maxLength": 2000,
          "pattern": "^https://"
        },
        "withdrawal_url": {
          "type": ["string", "null"],
          "minLength": 9,
          "maxLength": 2000,
          "pattern": "^https://"
        },
        "material_review": {
          "$ref": "#/$defs/materialReview"
        },
        "known_limits": {
          "$ref": "#/$defs/limitList"
        }
      },
      "additionalProperties": false
    }
  }
}
