{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/cambridgetcg/rhetorlint-spec/measurement/schema/items.schema.json",
 "title": "RhetorLint measurement items",
 "description": "One row per committed text in measurement/items/<id>.txt. Every licence must be one the repository can redistribute; sha256 and words are checked against the file by test/measurement.test.mjs.",
 "type": "object",
 "required": ["version", "items"],
 "additionalProperties": false,
 "properties": {
  "version": { "type": "integer", "minimum": 1, "maximum": 1 },
  "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } }
 },
 "$defs": {
  "item": {
   "type": "object",
   "required": ["id", "stratum", "register", "licence", "source", "retrieved", "sha256", "words", "title", "publisher", "provenance", "licence_evidence"],
   "additionalProperties": false,
   "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "stratum": { "enum": ["pastiche", "wild-pd", "target-genre", "technical"] },
    "register": { "enum": ["spin", "ham", "mixed"] },
    "licence": { "enum": ["CC-BY-SA-4.0", "US-federal-public-domain", "OGL-UK-3.0", "PSF-2.0"] },
    "source": { "type": "string", "pattern": "^(?:https://\\S+|invented)$" },
    "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "words": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "provenance": { "type": "string", "minLength": 1 },
    "excerpt": { "type": "string", "minLength": 1, "description": "What was kept when the item is not the whole source." },
    "note": { "type": "string", "minLength": 1 },
    "licence_evidence": {
     "type": "object",
     "required": ["url", "quote"],
     "additionalProperties": false,
     "properties": {
      "url": { "type": "string", "pattern": "^https://\\S+$" },
      "quote": { "type": "string", "minLength": 1, "description": "The licence statement as read on the source's own page." }
     }
    }
   }
  }
 }
}
