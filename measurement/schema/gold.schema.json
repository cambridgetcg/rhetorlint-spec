{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/cambridgetcg/rhetorlint-spec/measurement/schema/gold.schema.json",
 "title": "RhetorLint measurement gold spans",
 "description": "Spans a reader marked as doing rhetorical work, for recall. Offsets are UTF-16 code units into measurement/items/<item>.txt; text must equal that slice. A row with a rule counts toward that rule's recall; a row without one counts only toward any-rule recall.",
 "type": "object",
 "required": ["version", "sets", "annotations"],
 "additionalProperties": false,
 "properties": {
  "version": { "type": "integer", "minimum": 1, "maximum": 1 },
  "sets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/set" } },
  "annotations": { "type": "array", "items": { "$ref": "#/$defs/annotation" } }
 },
 "$defs": {
  "set": {
   "type": "object",
   "required": ["id", "annotator", "date", "read_rules_json", "before_detectors", "scope", "note"],
   "additionalProperties": false,
   "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "annotator": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "read_rules_json": { "type": "boolean", "description": "true when the annotator had read the rule pack, so the gold is not blind." },
    "before_detectors": { "type": ["boolean", "null"], "description": "true when annotated before any detector ran on the items; null when unknown." },
    "scope": { "type": "string", "minLength": 1 },
    "note": { "type": "string", "minLength": 1 }
   }
  },
  "annotation": {
   "type": "object",
   "required": ["item", "set", "start", "end", "text", "rule", "technique"],
   "additionalProperties": false,
   "properties": {
    "item": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "set": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "start": { "type": "integer", "minimum": 0 },
    "end": { "type": "integer", "minimum": 1 },
    "text": { "type": "string", "minLength": 1 },
    "rule": { "type": ["string", "null"], "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$" },
    "technique": { "type": "string", "minLength": 1 }
   }
  }
 }
}
