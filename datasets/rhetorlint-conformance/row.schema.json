{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cambridgetcg/rhetorlint-spec/blob/main/datasets/rhetorlint-conformance/row.schema.json",
  "title": "RhetorLint conformance evaluation row 0.1",
  "$comment": "Closed shape for the derived Hugging Face-compatible JSONL snapshot. Runtime checks additionally bind exact substrings, input and source digests, reference-engine equality, row order, release inventory and checksums.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "row_id",
    "split",
    "tasks",
    "input_text",
    "input_sha256",
    "expected",
    "label_summary",
    "provenance",
    "limits"
  ],
  "properties": {
    "schema": { "type": "string", "enum": ["rhetorlint.conformance-evaluation-row/0.1"] },
    "row_id": { "type": "string", "pattern": "^conformance-[0-9]{3}-[a-f0-9]{12}$" },
    "split": { "type": "string", "enum": ["test"] },
    "tasks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "reference-output-reproduction",
          "reference-mark-span-reproduction",
          "reference-strip-reproduction"
        ]
      }
    },
    "input_text": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "input_sha256": { "$ref": "#/$defs/digest" },
    "expected": { "$ref": "#/$defs/expected" },
    "label_summary": { "$ref": "#/$defs/labelSummary" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "limits": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "density": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tells", "per100Words"],
      "properties": {
        "tells": { "type": "integer", "minimum": 0, "maximum": 128 },
        "per100Words": { "type": "number", "minimum": 0, "maximum": 10000 }
      }
    },
    "mark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "family",
        "technique",
        "actual",
        "start",
        "end",
        "note",
        "confidence",
        "level",
        "expected"
      ],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1, "maxLength": 255 },
        "family": { "type": "string", "minLength": 1, "maxLength": 255 },
        "technique": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "actual": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "start": { "type": "integer", "minimum": 0, "maximum": 8000 },
        "end": { "type": "integer", "minimum": 1, "maximum": 8000 },
        "note": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "level": { "type": "string", "enum": ["note", "info", "warning"] },
        "expected": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["density", "strip", "marks"],
      "properties": {
        "density": { "$ref": "#/$defs/density" },
        "strip": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "marks": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/mark" }
        }
      }
    },
    "labelSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_ids", "families"],
      "properties": {
        "rule_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 255 }
        },
        "families": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 255 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_repository",
        "source_revision",
        "source_path",
        "source_case_index",
        "source_sha256",
        "rules_id",
        "rules_version",
        "rules_source_sha256",
        "core_source_sha256",
        "expected_outputs_origin",
        "independent_human_labels",
        "input_ascii",
        "cross_engine_scope"
      ],
      "properties": {
        "source_repository": {
          "type": "string",
          "enum": ["https://github.com/cambridgetcg/rhetorlint-spec"]
        },
        "source_revision": {
          "type": "string",
          "enum": ["5450687cbd46e52359c6d12e408c22ee1b38c5ea"]
        },
        "source_path": { "type": "string", "enum": ["conformance/cases.json"] },
        "source_case_index": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "source_sha256": { "$ref": "#/$defs/digest" },
        "rules_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "rules_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "rules_source_sha256": { "$ref": "#/$defs/digest" },
        "core_source_sha256": { "$ref": "#/$defs/digest" },
        "expected_outputs_origin": {
          "type": "string",
          "enum": ["generated-by-js-reference-engine-and-committed-as-reference-output"]
        },
        "independent_human_labels": { "type": "boolean", "enum": [false] },
        "input_ascii": { "type": "boolean", "enum": [true] },
        "cross_engine_scope": {
          "type": "string",
          "enum": ["python-compares-full-projection-go-omits-expected-suggestions-and-allows-float-tolerance"]
        }
      }
    }
  }
}
