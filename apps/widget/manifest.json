{
  "manifest_version": 3,
  "name": "RhetorLint — inspect rhetorical patterns",
  "version": "0.1.2",
  "description": "Inspect rhetorical patterns in selected text. Markers do not prove intent, effects, deception, or truth. Analysis stays on-device.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "RhetorLint — mark the selection (Alt+Shift+R)"
  },
  "commands": {
    "rhetorlint-run": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Mark the current selection"
    }
  },
  "permissions": ["activeTab"]
}
