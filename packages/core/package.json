{
  "name": "@rhetorlint/core",
  "version": "0.1.3",
  "description": "Reference engine for the RhetorLint spec: marks visible rhetorical patterns and projects testable inquiry prompts, on-device and zero-dependency.",
  "type": "module",
  "license": "MIT",
  "main": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./sarif": {
      "types": "./sarif.d.ts",
      "default": "./sarif.mjs"
    },
    "./signals": {
      "types": "./signals.d.ts",
      "default": "./signals.mjs"
    },
    "./inquiry": {
      "types": "./inquiry.d.ts",
      "default": "./inquiry.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "sarif.mjs",
    "sarif.d.ts",
    "signals.mjs",
    "signals.d.ts",
    "inquiry.mjs",
    "inquiry.d.ts",
    "README.md"
  ],
  "homepage": "https://github.com/cambridgetcg/rhetorlint-spec#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cambridgetcg/rhetorlint-spec.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "rhetorlint",
    "rhetoric",
    "rhetorical-effects",
    "truth-seeking",
    "agents",
    "media-literacy",
    "on-device"
  ],
  "sideEffects": false
}
